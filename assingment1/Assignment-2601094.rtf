\pard\sa200\sl276\slmult1 Q3- Take a sentence from the user, split it into words, and store them in a list. Print the longest word.\par
sentence = input("Enter a sentence: ")\par
\par
words_list = sentence.split()\par
\par
if words_list:\par
    # Find the longest word using max() with key=len\par
    longest_word = max(words_list, key=len)\par
    print(f"The longest word is: \{longest_word\}")\par
else:\par
    print("No words were entered.")\par

