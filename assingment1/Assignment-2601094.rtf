Q2- Read all lines from a file into a list. Print the total number of lines and display the 2nd and 4th line.\par
with open("sample.txt", "r") as file:\par
    lines = file.readlines()\par
\par
print(f"Total number of lines: \{len(lines)\}")\par
\par
if len(lines) >= 2:\par
    print(f"2nd line: \{lines[1].strip()\}")\par
else:\par
    print("The file has fewer than 2 lines.")\par
\par
if len(lines) >= 4:\par
    print(f"4th line: \{lines[3].strip()\}")\par
else:\par
    print("The file has fewer than 4 lines.")\par

